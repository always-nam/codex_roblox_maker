# Copy to .env on your server. Never put credentials in browser code.
PORT=3000
# Optional OpenAI Responses API connection. No AI calls occur without both values.
AI_PROVIDER=openai
# Preferred alias for cloud secret bindings:
AI_API_KEY=
# Alternative local/server variable (use one key variable):
OPENAI_API_KEY=
AI_MODEL=
AI_TIMEOUT_MS=90000
