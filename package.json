{
  "name": "roblox-game-planner",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node --check server.mjs && node --check planner.mjs && node --check public/app.js && node --check public/runtime.js && node --check scripts/build-pages.mjs && node --check scripts/build-mobile.mjs && node --check mobile/native-entry.js",
    "test:browser": "node tests/browser.mjs",
    "build:pages": "node scripts/build-pages.mjs",
    "test:pages": "node tests/pages-browser.mjs",
    "build:mobile": "node scripts/build-mobile.mjs && cap sync android",
    "android:debug": "cd android && ./gradlew --max-workers=4 assembleDebug",
    "android:bundle": "cd android && ./gradlew --max-workers=4 bundleRelease",
    "test:mobile": "node tests/mobile-browser.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "esbuild": "0.28.2",
    "playwright-core": "1.64.0"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/clipboard": "8.0.1",
    "@capacitor/core": "8.5.3",
    "@capacitor/filesystem": "8.1.4",
    "@capacitor/share": "8.0.3"
  }
}
